# Copy this file to .env and fill in the values.
# On Render, set these as environment variables in the dashboard — do NOT commit .env.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — Render / any PaaS (single URL, takes priority over individual vars)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — Local development (used when DATABASE_URL is not set)
DB_NAME=eventpass_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── SSL ───────────────────────────────────────────────────────────────────────
# Set False on Render/Railway (their edge proxy handles HTTPS, avoid redirect loop)
SECURE_SSL_REDIRECT=False
